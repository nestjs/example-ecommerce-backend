# PostgreSQL from docker-compose.yml.
DATABASE_URL=postgres://postgres:shop@localhost:5432/shop
# Signs the access tokens, at least 32 bytes. Generate with: openssl rand -base64 32
JWT_SECRET=

# Optional.
# PORT=3000
# NODE_ENV=development
# Browser origins allowed to call the API, comma-separated. None by default.
# CORS_ORIGINS=http://localhost:5173

# NestJS Observe: `npx @nestjs/observe link` writes OBSERVE_APP_KEY and
# OBSERVE_APP_SECRET here. Without them, the app sends no telemetry.
